# ==============================================================================
# KAPADKART FRONTEND — PRODUCTION & ENVIRONMENT CONFIGURATION TEMPLATE
# Production template. Copy to .env for production builds.
# `npm run dev` loads .env.development instead, which targets the local API.
#
# Cloudflare Pages: set the same VITE_* keys as build environment variables
# in the Pages project before `npm run deploy`. Vite inlines them into the bundle.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. BASE URL PATH
# ------------------------------------------------------------------------------
# - Root domain (production e.g. https://www.kapadkart.mohammadaman.in/):
#   VITE_BASE_PATH=/
# - Subpath deployment:
#   VITE_BASE_PATH=/
VITE_BASE_PATH=/

# ------------------------------------------------------------------------------
# 2. BACKEND API BASE URL
# ------------------------------------------------------------------------------
# - Separate backend API domain:
#   VITE_API_BASE_URL=https://www.api.kapadkart.mohammadaman.in
# - Same-domain / Reverse proxy (e.g. Cloudflare / Nginx proxying /api to backend):
#   Leave EMPTY so requests go to '/api/v1' on the same origin.
VITE_API_BASE_URL=https://www.api.kapadkart.mohammadaman.in

# ------------------------------------------------------------------------------
# 3. LOCAL DEVELOPMENT PROXY (Vite Dev Server Only)
# ------------------------------------------------------------------------------
# Forwarding target for local Vite dev server when running 'npm run dev'.
VITE_BACKEND_URL=http://localhost:4000

# ------------------------------------------------------------------------------
# 4. DEFAULT TENANT SLUG
# ------------------------------------------------------------------------------
# Fallback tenant used when no tenant slug is present in URL.
VITE_DEFAULT_TENANT_SLUG=demo-shop
