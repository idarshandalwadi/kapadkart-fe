# ==============================================================================
# KAPADKART FRONTEND — PRODUCTION & ENVIRONMENT CONFIGURATION TEMPLATE
# Production template. Copy to .env for production builds.
# `npm run dev` loads .env.development instead, which targets the local API.
#
# Cloudflare Pages (`npm run deploy`) uses .env.production, which leaves
# VITE_API_BASE_URL empty. functions/ then proxies /api to the Lightsail API.
# Do not point a Pages build at the HTTP API host; the browser will block it.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. BASE URL PATH
# ------------------------------------------------------------------------------
# - Root path on the EC2 host (production e.g. http://13.234.170.148/kapadkart/):
#   VITE_BASE_PATH=/
# - Subpath deployment:
#   VITE_BASE_PATH=/
VITE_BASE_PATH=/

# ------------------------------------------------------------------------------
# 2. BACKEND API BASE URL
# ------------------------------------------------------------------------------
# - Cloudflare Pages: leave empty. functions/ proxies /api to the API.
# - Browser calling the API host directly (HTTP pages only):
#   VITE_API_BASE_URL=http://13.234.170.148/kapadkart
VITE_API_BASE_URL=

# ------------------------------------------------------------------------------
# 3. LOCAL DEVELOPMENT PROXY (Vite Dev Server Only)
# ------------------------------------------------------------------------------
# Forwarding target for local Vite dev server when running 'npm run dev'.
VITE_BACKEND_URL=http://localhost:4000

# ------------------------------------------------------------------------------
# 4. DEFAULT TENANT SLUG
# ------------------------------------------------------------------------------
# Fallback tenant used when no tenant slug is present in URL.
VITE_DEFAULT_TENANT_SLUG=demo-shop
