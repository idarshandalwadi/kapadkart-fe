# Used by `npm run build` / `npm run deploy`.
# Leave the API base empty. The browser stays on the Pages origin (HTTPS).
# functions/ proxies /api, /uploads, and /images to http://13.234.170.148/kapadkart/api/v1.
# Setting this to the HTTP API host makes the browser block the calls as mixed content.
VITE_BASE_PATH=/
VITE_API_BASE_URL=
